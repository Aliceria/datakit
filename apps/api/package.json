{
  "name": "@datakit/api",
  "version": "0.1.0",
  "private": true,
  "description": "DataKit — API (Express)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "prisma migrate deploy && prisma generate && node --conditions=source --env-file-if-exists=../../.env --watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@datakit/core": "^0.1.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^12.11.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "prisma": "^7.10.1"
  }
}
