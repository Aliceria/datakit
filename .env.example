# DataKit — variáveis de ambiente. Copie para .env e ajuste.
# Só METRICS_HMAC_KEY é secreta: nunca a coloque no repositório.

# development | production | test
NODE_ENV=development

# Endereço e porta do Express. Em produção, atrás do Nginx, mantenha 127.0.0.1.
HOST=127.0.0.1
PORT=3000

# Banco SQLite. Em produção: fora da pasta do código, por exemplo file:/var/lib/datakit/datakit.db
# Sem esta variável, o padrão é data/datakit.db na raiz do repositório. Use caminho absoluto.
# DATABASE_URL=file:/var/lib/datakit/datakit.db

# Número de proxies reversos confiáveis na frente do Express (Nginx = 1). Usado para identificar o IP real.
TRUST_PROXY=0

# Limites por IP (seção 0). Padrões: 30 importações por hora e 10 sessões ativas.
# Aumente só se muitos usuários saírem pelo mesmo IP (ex.: rede de escritório com NAT).
# LIMIT_IMPORTS_PER_HOUR=30
# LIMIT_ACTIVE_SESSIONS_PER_IP=10

# Limite genérico de requisições por IP por minuto (proteção contra enxurrada).
# LIMIT_REQUESTS_PER_MINUTE=600

# Espaço máximo do banco, em bytes (seção 0: 5 GB). Acima dele, novos uploads são recusados.
# LIMIT_DATABASE_BYTES=5368709120

# Prazo entre fechar a aba e apagar a sessão, em ms (seção 0: 60 s). Só os testes o encurtam.
# SESSION_DELETE_AFTER_CLOSE_MS=60000

# Pasta com o build do frontend servido pelo Express. Padrão: apps/web/dist
# WEB_DIST_DIR=/opt/datakit/apps/web/dist

# Métricas de uso (painel /metrics). Sem METRICS_HMAC_KEY, nada é registrado.
# Chave do HMAC dos IPs: pelo menos 32 caracteres aleatórios. O valor abaixo é só exemplo;
# gere a sua com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# METRICS_HMAC_KEY=troque-por-uma-chave-aleatoria-de-32-caracteres-ou-mais

# Dias até apagar o HMAC e o IP mascarado dos registros (máximo 30). Os totais por dia ficam.
# METRICS_RETENTION_DAYS=30
